# Что НЕ раздаётся игрокам (синтаксис как у .gitignore).
# Всё перечисленное здесь либо не нужно на клиенте, либо не попадает в git —
# а проиндексированный, но неопубликованный файл даёт игроку ошибку 404 при установке.

# Локальный патчлог: в .gitignore, значит на GitHub его нет
CHANGELOG.md

# Логи модов: мусор, к тому же в .gitignore
*.log
config/CSC/**

# Резервные копии конфигов, которые плодят сами моды
*.bak

# Исходный zip базовой сборки — 300+ МБ, игрокам не нужен
aoc-aeronautics-*.zip

# Локальное состояние FancyMenu (переменные конкретного клиента)
config/fancymenu/user_variables.db
